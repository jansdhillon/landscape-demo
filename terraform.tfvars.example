# Name of the Terraform/OpenTofu workspace. Also used as the Juju model name.
workspace_name = ""

# Ubuntu Pro token (https://ubuntu.com/pro/dashboard)
pro_token = ""

# Path to your local SSH public key
path_to_ssh_key = ""

hostname = "landscape"
domain   = "example.com"

# After the first apply, an SRE must add the server IP to /etc/hosts on any machine
# that needs to reach the Landscape UI. See the README for details.

admin_name = "Landscape Admin"

admin_email = "admin@example.com"

admin_password = "changeme"

registration_key = ""

landscape_ppa = "ppa:landscape/latest-stable"

# Landscape Server charm
# haproxy = null  => Landscape 26.04 LTS beta+ (internal HAProxy, recommended)
# haproxy = {}   => pre-26.04 (deploys external HAProxy charm)
landscape_server = {
  channel = "25.10/edge"
  base    = "ubuntu@24.04"
  units   = 1
  config = {
    autoregistration               = "true"
    landscape_ppa                  = "ppa:landscape/self-hosted-beta"
    min_install                    = "true"
    enable_hostagent_messenger     = "true"
    enable_ubuntu_installer_attach = "true"
  }
}

# PostgreSQL configuration
postgresql = {
  channel = "16/stable"
  base    = "ubuntu@24.04"
}

# HAProxy — set to null to use Landscape Server's internal HAProxy (26.04 LTS beta+)
haproxy = null

# RabbitMQ Server configuration
rabbitmq_server = {
  channel = "latest/edge"
  base    = "ubuntu@24.04"
}

## LXD client VMs
lxd_vms = [
  {
    image_alias = "noble"
    client_config = {
      computer_title = "client-0"
    }
  },
  {
    image_alias = "jammy"
    client_config = {
      computer_title = "client-1"
    }
  }
]

## Ubuntu Core (optional)
ubuntu_core_series      = "core24"
ubuntu_core_count       = 0
ubuntu_core_device_name = "core-client"

# SMTP relay for Landscape system email (optional)
# smtp_host     = "smtp.sendgrid.net"
# smtp_port     = 587
# smtp_username = "apikey"
# smtp_password = ""
